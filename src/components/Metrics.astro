---
// Metrics section component
const metrics = [
    {
        label: "Time Saved",
        value: "200+ Hours",
        description: "Of furniture research, ordering, and setup — handled for you.",
        icon: "solar:clock-circle-linear"
    },
    {
        label: "Timeline",
        value: "6 Weeks",
        description: "From design kickoff to fully styled and photo-ready.",
        icon: "solar:calendar-linear"
    },
    {
        label: "Full-Service",
        value: "One Team",
        description: "Design, procurement, and install — all under one roof.",
        icon: "solar:users-group-rounded-linear"
    }
];
---

<section class="border-y border-brand-border bg-brand-black relative z-20 metrics-section">
    <div class="grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-brand-border max-w-[1400px] mx-auto">
        {metrics.map((metric, index) => (
            <div class="metric-card p-6 md:p-12 group transition-all duration-700 cursor-default relative overflow-hidden" style={`--delay: ${index * 0.15}s`}>
                <!-- Hover gradient overlay -->
                <div class="absolute inset-0 bg-gradient-to-b from-brand-gold/10 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 ease-out"></div>
                
                <div class="relative z-10">
                    <div class="flex justify-between items-start mb-3 md:mb-4">
                        <span class="metric-label text-[10px] md:text-xs uppercase tracking-widest text-brand-muted group-hover:text-brand-muted/80 transition-colors duration-500">{metric.label}</span>
                        <iconify-icon icon={metric.icon} class="text-brand-gold opacity-50 sm:opacity-0 group-hover:opacity-100 transition-all duration-500" width="18"></iconify-icon>
                    </div>
                    <h3 class="metric-value text-3xl md:text-4xl font-serif italic text-white mb-1 md:mb-2 group-hover:text-brand-cream transition-colors duration-500">{metric.value}</h3>
                    <p class="metric-desc text-[10px] md:text-xs text-brand-muted font-light group-hover:text-gray-400 transition-colors duration-500">{metric.description}</p>
                </div>
                
                <!-- Bottom border animation -->
                <div class="absolute bottom-0 left-0 h-[1px] w-0 bg-brand-gold/30 group-hover:w-full transition-all duration-700"></div>
            </div>
        ))}
    </div>
</section>

<style>
    .metric-card {
        opacity: 0;
        transform: translateY(20px);
        backface-visibility: hidden;
        will-change: transform, opacity;
    }
    
    .metrics-section.in-view .metric-card {
        animation: metricReveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        animation-delay: var(--delay);
    }
    
    @keyframes metricReveal {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
        const metricsSection = document.querySelector('.metrics-section');
        
        if (metricsSection) {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('in-view');
                    }
                });
            }, { threshold: 0.2 });
            
            observer.observe(metricsSection);
        }
    });
</script>
