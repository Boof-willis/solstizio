---
// About the Founder section
---

<section id="about" class="py-16 md:py-24 px-4 md:px-12 bg-brand-panel border-t border-brand-border about-section">
    <div class="max-w-[1400px] mx-auto">

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 md:gap-20 items-center">

            <!-- Image Column -->
            <div class="lg:col-span-5 about-image-col">
                <div class="relative">
                    <!-- Accent line -->
                    <div class="about-accent absolute -top-4 -left-4 w-24 h-24 border-t border-l border-brand-gold/30"></div>

                    <div class="overflow-hidden">
                        <img
                            src="/images/Hannah-Founder.jpg"
                            alt="Hannah McKernan, Founder of Solstizio Studios"
                            class="about-image w-full aspect-[3/4] object-cover object-top"
                        >
                    </div>

                    <!-- Floating credential tag -->
                    <div class="about-tag absolute -bottom-5 -right-4 md:-right-6 bg-brand-black border border-brand-border px-5 py-4">
                        <span class="block text-[9px] uppercase tracking-widest text-brand-gold mb-0.5">Credential</span>
                        <span class="block text-xs font-serif text-white tracking-tight">Certified Hospitality Designer</span>
                    </div>
                </div>
            </div>

            <!-- Content Column -->
            <div class="lg:col-span-7 about-content">
                <span class="about-label text-[10px] md:text-xs font-bold uppercase tracking-widest text-brand-gold mb-3 md:mb-4 block">The Designer</span>

                <h2 class="about-title text-3xl md:text-4xl lg:text-5xl font-serif leading-tight text-white mb-6 md:mb-8 tracking-tighter">
                    Built for<br>this.
                </h2>

                <div class="space-y-4 about-body">
                    <p class="text-sm md:text-base text-gray-300 font-light leading-relaxed">
                        <span class="text-brand-cream font-normal">Hannah McKernan</span> founded Solstizio Studios with one focus: short-term rental spaces that guests actually remember. As a <span class="text-brand-cream font-normal">Certified Hospitality Designer</span> with a B.A. from Kent State and continuing education from Parsons School of Design, she brings real construction experience, design training, and hospitality credentials to every project. Great STR design has to do more than look good in photos. The space also has to survive constant turnover, work the way guests expect, and earn its keep.
                    </p>
                    <p class="text-sm md:text-base text-gray-400 font-light leading-relaxed">
                        With <span class="text-brand-cream font-normal">7 years of STR experience</span>, Hannah served as the designer for <span class="text-brand-cream font-normal">Resort Style Vacation Homes</span>, one of the pioneering companies in the short-term rental industry, where she turned large residential estates into luxury, amenity-driven vacation properties built to compete directly with five-star resorts. That's firsthand experience designing properties to perform at the highest level of the STR market.
                    </p>
                    <p class="text-sm md:text-base text-gray-400 font-light leading-relaxed">
                        As the owner, Hannah personally visits and works on every property we take on, not only the ones she's leading. We use STR performance data too, but real operating experience tells us more than a spreadsheet ever could. The result is design that looks great and is built to perform.
                    </p>
                </div>

                <!-- Credentials row -->
                <div class="about-creds grid grid-cols-3 gap-4 mt-8 md:mt-10 pt-8 md:pt-10 border-t border-brand-border">
                    <div>
                        <span class="block text-lg md:text-xl font-serif text-white mb-0.5 tracking-tight">Certified</span>
                        <span class="text-[9px] uppercase tracking-widest text-brand-muted">Hospitality Designer<br>Parsons-Trained</span>
                    </div>
                    <div>
                        <span class="block text-lg md:text-xl font-serif text-white mb-0.5 tracking-tight">7 Years</span>
                        <span class="text-[9px] uppercase tracking-widest text-brand-muted">Luxe STR Design<br>Experience</span>
                    </div>
                    <div>
                        <span class="block text-lg md:text-xl font-serif text-white mb-0.5 tracking-tight">Hands-On</span>
                        <span class="text-[9px] uppercase tracking-widest text-brand-muted">Hannah on<br>Every Project</span>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<style>
    /* Image reveal */
    .about-image-col {
        opacity: 0;
        transform: translateX(-30px);
    }

    .about-section.in-view .about-image-col {
        animation: aboutSlideIn 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes aboutSlideIn {
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .about-image {
        transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        transform: translateZ(0);
        will-change: transform;
        backface-visibility: hidden;
    }

    .about-image-col:hover .about-image {
        transform: scale(1.02);
    }

    /* Accent corner */
    .about-accent {
        opacity: 0;
        transform: translate(8px, 8px);
    }

    .about-section.in-view .about-accent {
        animation: accentReveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
    }

    @keyframes accentReveal {
        to {
            opacity: 1;
            transform: translate(0, 0);
        }
    }

    /* Floating tag */
    .about-tag {
        opacity: 0;
        transform: translateY(10px);
    }

    .about-section.in-view .about-tag {
        animation: aboutFadeUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.5s forwards;
    }

    /* Content animations */
    .about-label {
        opacity: 0;
        transform: translateY(10px);
    }

    .about-section.in-view .about-label {
        animation: aboutFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
    }

    .about-title {
        opacity: 0;
        transform: translateY(20px);
    }

    .about-section.in-view .about-title {
        animation: aboutFadeUp 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
    }

    .about-body {
        opacity: 0;
        transform: translateY(20px);
    }

    .about-section.in-view .about-body {
        animation: aboutFadeUp 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.45s forwards;
    }

    .about-creds {
        opacity: 0;
        transform: translateY(15px);
    }

    .about-section.in-view .about-creds {
        animation: aboutFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.6s forwards;
    }

    @keyframes aboutFadeUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
        const section = document.querySelector('.about-section');

        if (section) {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('in-view');
                    }
                });
            }, { 
                threshold: 0,
                rootMargin: "0px 0px -20% 0px"
            });

            observer.observe(section);
        }
    });
</script>
