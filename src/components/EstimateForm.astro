---
// Estimate form section component
---

<section id="estimate" class="py-16 md:py-24 px-4 md:px-12 bg-brand-panel border-t border-brand-border estimate-section">
    <div class="max-w-[1400px] mx-auto grid grid-cols-1 lg:grid-cols-2 gap-10 md:gap-32">
        <!-- Left Side -->
        <div class="estimate-left space-y-6 md:space-y-8">
            <h2 class="estimate-title text-3xl sm:text-4xl md:text-6xl font-serif text-white">
                <span class="block overflow-hidden">
                    <span class="estimate-title-line">Project</span>
                </span>
                <span class="block overflow-hidden">
                    <span class="estimate-title-line">Estimation</span>
                </span>
            </h2>
            <p class="estimate-desc text-gray-400 font-light max-w-md text-sm md:text-base">
                Tell us about your investment. We will provide a preliminary budget breakdown within 24 hours.
            </p>
            <div class="estimate-contact space-y-3 md:space-y-4 pt-4 md:pt-8">
                <div class="flex items-center gap-3 md:gap-4 text-sm text-gray-500 hover:text-gray-300 transition-colors duration-300 cursor-pointer group">
                    <iconify-icon icon="solar:letter-linear" width="18" class="group-hover:text-brand-gold transition-colors duration-300"></iconify-icon>
                    <span>hello@solstizio.com</span>
                </div>
                <div class="flex items-center gap-3 md:gap-4 text-sm text-gray-500 hover:text-gray-300 transition-colors duration-300 cursor-pointer group">
                    <iconify-icon icon="solar:phone-calling-linear" width="18" class="group-hover:text-brand-gold transition-colors duration-300"></iconify-icon>
                    <span>+1 (480) 555-0192</span>
                </div>
            </div>
        </div>

        <!-- Right Side (Form) -->
        <form class="estimate-form space-y-8 md:space-y-12 pt-2 md:pt-4">
            <div class="grid grid-cols-1 gap-8 md:grid-cols-2 md:gap-12">
                <div class="form-field group relative" style="--field-delay: 0s">
                    <input type="text" id="name" required placeholder=" " class="block w-full bg-transparent border-b border-white/10 py-2 text-white placeholder-transparent focus:outline-none peer text-sm">
                    <label for="name" class="absolute left-0 -top-3.5 text-[10px] text-gray-500 uppercase tracking-widest transition-all duration-300 peer-placeholder-shown:text-sm peer-placeholder-shown:text-gray-500 peer-placeholder-shown:top-2 peer-focus:-top-3.5 peer-focus:text-brand-gold peer-focus:text-[10px]">Full Name</label>
                    <div class="form-field-line absolute bottom-0 left-0 h-[1px] w-0 bg-brand-gold"></div>
                </div>
                
                <div class="form-field group relative" style="--field-delay: 0.1s">
                    <input type="email" id="email" required placeholder=" " class="block w-full bg-transparent border-b border-white/10 py-2 text-white placeholder-transparent focus:outline-none peer text-sm">
                    <label for="email" class="absolute left-0 -top-3.5 text-[10px] text-gray-500 uppercase tracking-widest transition-all duration-300 peer-placeholder-shown:text-sm peer-placeholder-shown:text-gray-500 peer-placeholder-shown:top-2 peer-focus:-top-3.5 peer-focus:text-brand-gold peer-focus:text-[10px]">Email Address</label>
                    <div class="form-field-line absolute bottom-0 left-0 h-[1px] w-0 bg-brand-gold"></div>
                </div>
            </div>

            <div class="grid grid-cols-1 gap-8 md:grid-cols-2 md:gap-12">
                <div class="form-field group relative" style="--field-delay: 0.2s">
                    <input type="text" id="property" required placeholder=" " class="block w-full bg-transparent border-b border-white/10 py-2 text-white placeholder-transparent focus:outline-none peer text-sm">
                    <label for="property" class="absolute left-0 -top-3.5 text-[10px] text-gray-500 uppercase tracking-widest transition-all duration-300 peer-placeholder-shown:text-sm peer-placeholder-shown:text-gray-500 peer-placeholder-shown:top-2 peer-focus:-top-3.5 peer-focus:text-brand-gold peer-focus:text-[10px]">Property Address / City</label>
                    <div class="form-field-line absolute bottom-0 left-0 h-[1px] w-0 bg-brand-gold"></div>
                </div>

                <div class="form-field group relative" style="--field-delay: 0.3s">
                    <select id="budget" class="block w-full bg-transparent border-b border-white/10 py-2 text-white focus:outline-none text-sm appearance-none cursor-pointer">
                        <option value="" class="bg-brand-panel text-gray-500">Select SQFT Range</option>
                        <option value="1" class="bg-brand-panel text-white">Under 2,000 sqft</option>
                        <option value="2" class="bg-brand-panel text-white">2,000 - 3,500 sqft</option>
                        <option value="3" class="bg-brand-panel text-white">3,500 - 5,000 sqft</option>
                        <option value="4" class="bg-brand-panel text-white">5,000+ sqft</option>
                    </select>
                    <iconify-icon icon="solar:alt-arrow-down-linear" class="absolute right-0 top-2 text-gray-500 pointer-events-none group-hover:text-brand-gold transition-colors duration-300"></iconify-icon>
                    <label for="budget" class="absolute left-0 -top-3.5 text-[10px] text-gray-500 uppercase tracking-widest">Property Size</label>
                    <div class="form-field-line absolute bottom-0 left-0 h-[1px] w-0 bg-brand-gold"></div>
                </div>
            </div>

            <div class="form-submit pt-2 md:pt-4">
                <button type="submit" class="submit-btn w-full sm:w-auto bg-brand-gold/10 hover:bg-brand-gold text-brand-gold hover:text-black border border-brand-gold/20 hover:border-brand-gold px-8 md:px-10 py-4 text-[10px] font-bold uppercase tracking-[0.15em] md:tracking-[0.2em] transition-all duration-500 relative overflow-hidden group">
                    <span class="relative z-10">Calculate ROI</span>
                    <div class="absolute inset-0 bg-brand-gold transform -translate-x-full group-hover:translate-x-0 transition-transform duration-500 ease-out"></div>
                </button>
            </div>
        </form>
    </div>
</section>

<style>
    /* Title animation */
    .estimate-title-line {
        display: inline-block;
        transform: translateY(100%);
    }
    
    .estimate-section.in-view .estimate-title-line {
        animation: titleUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    
    .estimate-section.in-view .estimate-title span:nth-child(2) .estimate-title-line {
        animation-delay: 0.1s;
    }
    
    @keyframes titleUp {
        to { transform: translateY(0); }
    }
    
    /* Description animation */
    .estimate-desc {
        opacity: 0;
        transform: translateY(20px);
    }
    
    .estimate-section.in-view .estimate-desc {
        animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
    }
    
    /* Contact animation */
    .estimate-contact {
        opacity: 0;
        transform: translateY(20px);
    }
    
    .estimate-section.in-view .estimate-contact {
        animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.5s forwards;
    }
    
    @keyframes fadeUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    /* Form field animations */
    .form-field {
        opacity: 0;
        transform: translateY(30px);
    }
    
    .estimate-section.in-view .form-field {
        animation: fieldReveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        animation-delay: calc(0.4s + var(--field-delay));
    }
    
    @keyframes fieldReveal {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    /* Focus line animation */
    .form-field input:focus ~ .form-field-line,
    .form-field select:focus ~ .form-field-line {
        animation: lineExpand 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    
    @keyframes lineExpand {
        to { width: 100%; }
    }
    
    /* Submit button animation */
    .form-submit {
        opacity: 0;
        transform: translateY(20px);
    }
    
    .estimate-section.in-view .form-submit {
        animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.8s forwards;
    }
    
    /* Button text stays white on hover */
    .submit-btn:hover span {
        color: black;
    }
</style>

<script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
        const section = document.querySelector('.estimate-section');
        
        if (section) {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('in-view');
                    }
                });
            }, { threshold: 0.2 });
            
            observer.observe(section);
        }
    });
</script>
