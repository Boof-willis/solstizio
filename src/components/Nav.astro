---
// Navigation component
---

<nav id="main-nav" class="fixed top-0 left-0 right-0 z-[60] text-white py-4 md:py-6 px-4 md:px-12 transition-all duration-700">
    <div class="flex items-center justify-between max-w-[1400px] mx-auto relative z-[70]">
        <a href="#" class="relative group nav-logo">
            <img src="/images/Solstizio-logo-2.png" alt="Solstizio Studios" class="w-[120px] md:w-[170px] h-auto invert drop-shadow-lg transition-all duration-500 group-hover:scale-105">
        </a>

        <!-- Desktop Menu -->
        <div class="hidden md:flex items-center gap-12 text-xs font-medium tracking-widest uppercase drop-shadow-lg stagger-fade">
            <a href="#process" class="nav-link opacity-70 hover:opacity-100 transition-all duration-300 underline-slide">Method</a>
            <a href="#portfolio" class="nav-link opacity-70 hover:opacity-100 transition-all duration-300 underline-slide">Work</a>
            <a href="#reviews" class="nav-link opacity-70 hover:opacity-100 transition-all duration-300 underline-slide">Reviews</a>
        </div>

        <!-- Desktop CTA -->
        <a href="#estimate" class="hidden md:flex items-center gap-2 group drop-shadow-lg nav-cta">
            <span class="text-xs font-bold tracking-widest uppercase relative overflow-hidden">
                <span class="inline-block transition-transform duration-500 group-hover:-translate-y-full">Start Project</span>
                <span class="absolute left-0 top-full inline-block transition-transform duration-500 group-hover:-translate-y-full text-brand-gold">Start Project</span>
            </span>
            <iconify-icon icon="solar:arrow-right-linear" width="18" class="group-hover:translate-x-1.5 transition-transform duration-500"></iconify-icon>
        </a>

        <!-- Mobile Menu Button -->
        <button class="md:hidden text-white p-2 relative z-[80]" id="mobile-menu-btn" aria-label="Toggle menu">
            <span class="menu-icon-bar"></span>
            <span class="menu-icon-bar"></span>
        </button>
    </div>
    
    <!-- Mobile Menu Overlay -->
    <div id="mobile-menu" class="fixed inset-0 z-[65] bg-brand-black/95 backdrop-blur-xl flex flex-col justify-center px-8 md:hidden mobile-menu-container">
        <div class="flex flex-col gap-8 items-start">
            <a href="#process" class="text-4xl font-serif font-light text-white hover:text-brand-gold transition-colors mobile-link opacity-0 translate-y-4">Method</a>
            <a href="#portfolio" class="text-4xl font-serif font-light text-white hover:text-brand-gold transition-colors mobile-link opacity-0 translate-y-4">Work</a>
            <a href="#reviews" class="text-4xl font-serif font-light text-white hover:text-brand-gold transition-colors mobile-link opacity-0 translate-y-4">Reviews</a>
            <div class="h-[1px] w-12 bg-white/20 my-4 mobile-link opacity-0"></div>
            <a href="#estimate" class="text-sm font-bold tracking-[0.2em] uppercase text-brand-gold mobile-link opacity-0 translate-y-4">Start Project</a>
        </div>
        <div class="absolute bottom-12 left-8 text-[10px] text-gray-500 tracking-widest uppercase">
            © 2026 Solstizio Studios
        </div>
    </div>
</nav>

<style>
    /* Nav scroll states */
    #main-nav.scrolled {
        background: rgba(5, 5, 5, 0.85);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        padding-top: 0.75rem;
        padding-bottom: 0.75rem;
    }
    
    #main-nav.scrolled .nav-logo img {
        width: 120px;
    }
    
    /* Mobile menu button animation */
    .menu-icon-bar {
        display: block;
        width: 24px;
        height: 1px;
        background: white;
        margin: 6px 0;
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    
    #mobile-menu-btn.active .menu-icon-bar:first-child {
        transform: translateY(3.5px) rotate(45deg);
    }
    
    #mobile-menu-btn.active .menu-icon-bar:last-child {
        transform: translateY(-3.5px) rotate(-45deg);
    }
    
    /* Mobile menu animations */
    .mobile-menu-container.active .mobile-link {
        opacity: 1;
        transform: translateY(0);
    }
    
    .mobile-menu-container.active .mobile-link:nth-child(1) { transition-delay: 0.1s; }
    .mobile-menu-container.active .mobile-link:nth-child(2) { transition-delay: 0.2s; }
    .mobile-menu-container.active .mobile-link:nth-child(3) { transition-delay: 0.3s; }
    .mobile-menu-container.active .mobile-link:nth-child(4) { transition-delay: 0.4s; }
    .mobile-menu-container.active .mobile-link:nth-child(5) { transition-delay: 0.5s; }
    
    .mobile-link {
        transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    
    /* Mobile menu slide animation */
    .mobile-menu-container {
        transform: translateX(100%);
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        visibility: hidden;
    }
    
    .mobile-menu-container.active {
        transform: translateX(0);
        visibility: visible;
    }
</style>

<script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
        const nav = document.getElementById('main-nav');
        const menuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const mobileLinks = document.querySelectorAll('.mobile-link');
        
        // Scroll-triggered nav styling
        let lastScroll = 0;
        window.addEventListener('scroll', function() {
            const currentScroll = window.pageYOffset;
            
            if (currentScroll > 100) {
                nav.classList.add('scrolled');
            } else {
                nav.classList.remove('scrolled');
            }
            
            lastScroll = currentScroll;
        }, { passive: true });
        
        // Mobile menu toggle
        if (menuBtn && mobileMenu) {
            menuBtn.addEventListener('click', function() {
                const isOpen = mobileMenu.classList.contains('active');
                menuBtn.classList.toggle('active');
                mobileMenu.classList.toggle('active');
                document.body.style.overflow = isOpen ? '' : 'hidden';
            });
            
            mobileLinks.forEach(link => {
                link.addEventListener('click', function() {
                    menuBtn.classList.remove('active');
                    mobileMenu.classList.remove('active');
                    document.body.style.overflow = '';
                });
            });
        }
    });
</script>
