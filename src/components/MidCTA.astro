---
// Mid-page CTA banner component
---

<section class="py-12 md:py-16 px-4 md:px-12 bg-brand-panel border-y border-brand-border midcta-section">
    <div class="max-w-[1400px] mx-auto flex flex-col md:flex-row items-center justify-between gap-6 md:gap-12">
        <div class="midcta-content text-center md:text-left">
            <h3 class="text-2xl md:text-3xl font-serif text-white mb-2">Wondering what your project will cost?</h3>
            <p class="text-sm text-gray-400 font-light">Get a free estimate in under 60 seconds — no commitment.</p>
        </div>
        <a href="#estimate" class="midcta-button shrink-0 bg-brand-gold/10 hover:bg-brand-gold text-brand-gold hover:text-black border border-brand-gold/20 hover:border-brand-gold px-8 md:px-10 py-4 text-[10px] font-bold uppercase tracking-[0.15em] md:tracking-[0.2em] transition-all duration-500 relative overflow-hidden group">
            <span class="relative z-10">Get Your Estimate</span>
            <div class="absolute inset-0 bg-brand-gold transform -translate-x-full group-hover:translate-x-0 transition-transform duration-500 ease-out"></div>
        </a>
    </div>
</section>

<style>
    .midcta-content {
        opacity: 0;
        transform: translateY(20px);
    }

    .midcta-section.in-view .midcta-content {
        animation: midctaFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .midcta-button {
        opacity: 0;
        transform: translateY(20px);
    }

    .midcta-section.in-view .midcta-button {
        animation: midctaFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.15s forwards;
    }

    @keyframes midctaFadeUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
        const section = document.querySelector('.midcta-section');

        if (section) {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('in-view');
                    }
                });
            }, { threshold: 0.3 });

            observer.observe(section);
        }
    });
</script>
