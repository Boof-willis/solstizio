---
// Process section component
const steps = [
    {
        number: "01",
        title: "Design",
        timeline: "2 Weeks",
        description: "We get to know your property, your market, and your budget. Our interior design team creates a custom design plan tailored to your rental's location and the guests you want to attract.",
        deliverables: ["Custom mood boards", "Room-by-room design plan", "Full product selections"],
        icon: "solar:pen-new-round-linear"
    },
    {
        number: "02",
        title: "Order & Procure",
        timeline: "4 Weeks",
        description: "Through our trade partnerships, we source all furniture, decor, and essentials — tailored to your budget. We handle every order, track every shipment, and receive items at our warehouse for inspection.",
        deliverables: ["Trade-priced furnishings", "Shipment tracking", "Warehouse inspection"],
        icon: "solar:box-minimalistic-linear"
    },
    {
        number: "03",
        title: "Install & Style",
        timeline: "1 Week",
        description: "Our team brings it all together on-site. We assemble, arrange, and style every detail so your property is photo-ready and guest-ready from day one.",
        deliverables: ["Full assembly & placement", "Decor styling", "Photo-ready walkthrough"],
        icon: "solar:armchair-2-linear"
    }
];
---

<section id="process" class="py-16 md:py-24 bg-brand-panel border-t border-brand-border process-section">
    <div class="max-w-[1400px] mx-auto px-4 md:px-12">
        <div class="flex flex-col md:flex-row gap-8 md:gap-24">
            <!-- Left Side (Header) -->
            <div class="md:w-1/3 md:sticky md:top-32 md:h-fit process-header">
                <span class="process-label text-[10px] md:text-xs font-bold uppercase tracking-widest text-brand-gold mb-3 md:mb-4 block">How It Works</span>
                <h3 class="process-title text-3xl md:text-4xl lg:text-5xl font-serif leading-tight md:leading-none tracking-tighter">
                    <span class="block overflow-hidden">
                        <span class="process-title-line">Design to Done</span>
                    </span>
                    <span class="block overflow-hidden">
                        <span class="process-title-line">in 6 Weeks.</span>
                    </span>
                </h3>
                <p class="process-desc mt-4 md:mt-8 text-sm text-gray-400 font-light leading-relaxed">
                    You provide the property — we handle everything else. Design, ordering, warehousing, assembly, and styling. Your only job is to hand us the keys.
                </p>

                <!-- Behind the scenes photo removed -->
            </div>

            <!-- Right Side (Steps) -->
            <div class="md:w-2/3 space-y-0">
                {steps.map((step, index) => (
                    <div 
                        class="process-step group border-b border-brand-border py-6 md:py-12 hover:bg-white/[0.02] transition-all duration-500 px-3 md:px-4 -mx-3 md:-mx-4 relative overflow-hidden"
                        style={`--step-delay: ${index * 0.15}s`}
                    >
                        <!-- Progress line -->
                        <div class="process-step-line absolute left-0 top-0 h-full w-[2px] bg-brand-gold/0 group-hover:bg-brand-gold/50 transition-colors duration-700"></div>
                        
                        <div class="flex items-start gap-4 md:justify-between relative z-10">
                            <span class="process-number text-xs font-mono text-brand-gold mt-0.5 md:mt-1 shrink-0 transition-all duration-500">{step.number}</span>
                            <div class="flex-1 md:w-10/12">
                                <div class="flex items-start justify-between gap-4">
                                    <div class="flex items-center gap-3">
                                        <h4 class="process-step-title text-xl md:text-2xl font-serif text-white mb-0 tracking-tight">{step.title}</h4>
                                        <span class="text-[9px] font-bold uppercase tracking-widest text-brand-gold/70 border border-brand-gold/20 px-2 py-0.5 rounded-full whitespace-nowrap">{step.timeline}</span>
                                    </div>
                                    <iconify-icon icon={step.icon} class="process-step-icon text-white opacity-30 md:opacity-20 group-hover:opacity-100 group-hover:text-brand-gold group-hover:rotate-6 transition-all duration-500 shrink-0" width="20"></iconify-icon>
                                </div>
                                <p class="process-step-desc text-sm text-gray-500 font-light max-w-md group-hover:text-gray-300 transition-colors duration-500 mb-3">{step.description}</p>
                                <div class="flex flex-wrap gap-2">
                                    {step.deliverables.map((d: string) => (
                                        <span class="text-[9px] uppercase tracking-wider text-brand-gold/60 bg-brand-gold/5 border border-brand-gold/10 px-2.5 py-1 rounded-full group-hover:text-brand-gold/90 group-hover:border-brand-gold/25 transition-all duration-500">{d}</span>
                                    ))}
                                </div>
                            </div>
                        </div>
                        
                        <!-- Bottom border animation -->
                        <div class="absolute bottom-0 left-0 h-[1px] w-0 bg-brand-gold/20 group-hover:w-full transition-all duration-700"></div>
                    </div>
                ))}
            </div>
        </div>
    </div>
</section>

<style>
    /* Header animations */
    .process-label {
        opacity: 0;
        transform: translateY(10px);
    }
    
    .process-section.in-view .process-label {
        animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    
    .process-title-line {
        display: inline-block;
        transform: translateY(100%);
    }
    
    .process-section.in-view .process-title-line {
        animation: lineUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    
    .process-section.in-view .process-title span:nth-child(2) .process-title-line {
        animation-delay: 0.1s;
    }
    
    @keyframes lineUp {
        to { transform: translateY(0); }
    }
    
    @keyframes fadeUp {
        to { 
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .process-desc {
        opacity: 0;
        transform: translateY(20px);
    }
    
    .process-section.in-view .process-desc {
        animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
    }

    
    /* Step animations */
    .process-step {
        opacity: 0;
        transform: translateX(-20px);
    }
    
    .process-section.in-view .process-step {
        animation: stepReveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        animation-delay: var(--step-delay);
    }
    
    @keyframes stepReveal {
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }
    
    /* Hover state for step line */
    .process-step-line {
        transform: scaleY(0);
        transform-origin: top;
        transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.3s;
    }
    
    .process-step:hover .process-step-line {
        transform: scaleY(1);
        background-color: rgba(138, 154, 123, 0.5);
    }
</style>

<script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
        const section = document.querySelector('.process-section');
        
        if (section) {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('in-view');
                    }
                });
            }, { threshold: 0.2 });
            
            observer.observe(section);
        }
    });
</script>
