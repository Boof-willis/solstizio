---
// Hero section component
---

<header class="relative h-[100dvh] w-full flex items-center justify-center overflow-hidden">
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
        <!-- Gradient Overlay: Dark bottom -> dark middle -> lighter top for nav contrast -->
        <div class="absolute inset-0 bg-gradient-to-t from-brand-black via-brand-black/60 to-brand-black/30 z-10"></div>
        <!-- Left-side scrim behind the text column (desktop) -->
        <div class="hidden md:block absolute inset-0 bg-gradient-to-r from-black/55 via-black/15 to-transparent z-10"></div>
        <!-- Extra darkening for bright images (mobile, where text spans the frame) -->
        <div class="md:hidden absolute inset-0 bg-black/30 z-10"></div>
        <!-- Mobile Hero Image Carousel -->
        <div class="md:hidden absolute inset-0 w-full h-full">
            <img
                src="/images/neon-bedroom-mobile.avif"
                class="absolute inset-0 w-full h-full object-cover hero-carousel-img-mobile opacity-100 transition-opacity duration-[2000ms]"
                alt="Designed short-term rental bedroom with neon accent"
            >
            <img
                src="/images/nightstand-mobile.avif"
                class="absolute inset-0 w-full h-full object-cover hero-carousel-img-mobile opacity-0 transition-opacity duration-[2000ms]"
                alt="Styled bedroom nightstand detail"
            >
            <img
                src="/images/karaoke-bar-mobile.avif"
                class="absolute inset-0 w-full h-full object-cover hero-carousel-img-mobile opacity-0 transition-opacity duration-[2000ms]"
                alt="Short-term rental karaoke bar"
            >
            <img
                src="/images/corn-hole-mobile.avif"
                class="absolute inset-0 w-full h-full object-cover hero-carousel-img-mobile opacity-0 transition-opacity duration-[2000ms]"
                alt="Short-term rental game area with cornhole"
            >
        </div>
        <!-- Desktop Hero Image Carousel -->
        <div class="hidden md:block absolute inset-0 w-full h-full">
            <img 
                src="/images/casa-serenity.avif"
                class="absolute inset-0 w-full h-full object-cover hero-img hero-carousel-img opacity-100 transition-opacity duration-[2000ms] scale-105"
                alt="Designed short-term rental living space"
            >
            <img 
                src="/images/beatiful-bathroom-desktop.avif"
                class="absolute inset-0 w-full h-full object-cover hero-img hero-carousel-img opacity-0 transition-opacity duration-[2000ms] scale-105"
                alt="Luxury short-term rental bathroom design"
            >
            <img 
                src="/images/living-room-checkered-wall-desktop.avif"
                class="absolute inset-0 w-full h-full object-cover hero-img hero-carousel-img opacity-0 transition-opacity duration-[2000ms] scale-105"
                alt="Short-term rental living room with checkered accent wall"
            >
            <img 
                src="/images/karaoke-bar-desktop.avif"
                class="absolute inset-0 w-full h-full object-cover hero-img hero-carousel-img opacity-0 transition-opacity duration-[2000ms] scale-105"
                alt="Designed short-term rental karaoke bar"
            >
        </div>
    </div>

    <div class="relative z-20 w-full max-w-[1400px] px-6 md:px-12 flex flex-col md:flex-row items-start md:items-end justify-between pb-12 md:pb-24 h-full pt-32 md:pt-0">
        <!-- Left Content -->
        <div class="space-y-6 md:space-y-6 max-w-4xl mt-auto md:mt-0">
            <div class="overflow-hidden">
                <p class="hero-label text-xs md:text-xs font-bold tracking-[0.2em] text-gray-300 opacity-80 uppercase mb-4 flex items-center gap-3">
                    <span class="hero-line w-8 md:w-8 h-[1px] bg-gray-300"></span>
                    <span class="hero-label-text">Interior Design for Short-Term Rentals</span>
                </p>
            </div>
            
            <div>
                <h1 class="hero-title text-[2rem] sm:text-4xl md:text-5xl lg:text-6xl font-serif font-light tracking-tighter leading-[0.95] text-white">
                    <span class="hero-word-line">Turn Your Property Into a Rental</span>
                    <span class="hero-word-line">Guests Can't Scroll Past.</span>
                </h1>
                <p class="text-brand-cream italic font-normal opacity-90 hero-word-italic text-2xl sm:text-3xl md:text-4xl font-serif tracking-tight mt-3 md:mt-4">Turnkey Interior Design &amp; Setup</p>
            </div>

            <div class="hero-description max-w-md mt-6 md:mt-8 border-l border-white/20 pl-6">
                <p class="text-base md:text-base text-gray-300 font-light leading-relaxed">
                    We design, furnish, install and style your short-term rental from top to bottom, so you can launch faster, stand out in your market, and start earning.
                </p>
                <a href="#estimate" class="hidden md:inline-block mt-8 bg-white text-black px-8 py-3 rounded-none text-xs font-bold uppercase tracking-widest transition-all duration-300 hover:bg-brand-gold hover:text-black active:scale-[0.98]">
                    Get Your Estimate
                </a>

                <!-- Google rating badge (desktop) -->
                <a href="#reviews" class="hero-google-badge hidden md:flex items-center gap-2 mt-5 group w-fit">
                    <iconify-icon icon="logos:google-icon" width="14"></iconify-icon>
                    <span class="flex items-center gap-0.5">
                        <iconify-icon icon="solar:star-bold" class="text-brand-gold" width="11"></iconify-icon>
                        <iconify-icon icon="solar:star-bold" class="text-brand-gold" width="11"></iconify-icon>
                        <iconify-icon icon="solar:star-bold" class="text-brand-gold" width="11"></iconify-icon>
                        <iconify-icon icon="solar:star-bold" class="text-brand-gold" width="11"></iconify-icon>
                        <iconify-icon icon="solar:star-bold" class="text-brand-gold" width="11"></iconify-icon>
                    </span>
                    <span class="text-[10px] font-bold uppercase tracking-widest text-white drop-shadow-md">5.0</span>
                    <span class="text-[10px] uppercase tracking-widest text-white/70 group-hover:text-white transition-colors duration-300 drop-shadow-md">Verified Google Reviews</span>
                </a>
            </div>
            
            <!-- Mobile CTA & Social Proof -->
            <div class="md:hidden flex flex-col items-start gap-4 hero-mobile-cta">
                <a href="#estimate" class="inline-block mt-4 bg-white text-black px-10 py-4 rounded-none transition-all duration-300 hover:bg-brand-gold hover:text-black active:scale-[0.98]">
                    <span class="text-xs font-bold tracking-widest uppercase">Get Your Estimate</span>
                </a>

                <!-- Google rating badge (mobile) -->
                <a href="#reviews" class="hero-google-badge flex items-center gap-2">
                    <iconify-icon icon="logos:google-icon" width="13"></iconify-icon>
                    <span class="flex items-center gap-0.5">
                        <iconify-icon icon="solar:star-bold" class="text-brand-gold" width="10"></iconify-icon>
                        <iconify-icon icon="solar:star-bold" class="text-brand-gold" width="10"></iconify-icon>
                        <iconify-icon icon="solar:star-bold" class="text-brand-gold" width="10"></iconify-icon>
                        <iconify-icon icon="solar:star-bold" class="text-brand-gold" width="10"></iconify-icon>
                        <iconify-icon icon="solar:star-bold" class="text-brand-gold" width="10"></iconify-icon>
                    </span>
                    <span class="text-[10px] font-bold uppercase tracking-widest text-white drop-shadow-md">5.0</span>
                    <span class="text-[9px] uppercase tracking-widest text-white/70 drop-shadow-md">Verified Google Reviews</span>
                </a>
            </div>
        </div>

            <!-- Desktop Right Column -->
        <div class="hidden md:flex flex-col items-end gap-4 hero-right">
            <div class="flex items-center gap-6 hero-logos">
                <span class="text-[10px] uppercase tracking-widest text-white/90 font-medium drop-shadow-md">Designed for all major STR platforms</span>
            </div>
            
        </div>
    </div>
    
    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 hidden md:flex flex-col items-center gap-2 scroll-indicator">
        <span class="text-[9px] uppercase tracking-widest text-white/40">Scroll</span>
        <div class="w-[1px] h-12 bg-gradient-to-b from-white/40 to-transparent scroll-line"></div>
    </div>
</header>

<style>
    /* Hero Image Ken Burns Effect - Desktop only for performance */
    @keyframes heroZoom {
        0% { transform: scale(1.05); }
        100% { transform: scale(1.15); }
    }
    
    .hero-img {
        animation: none;
    }
    
    @media (min-width: 768px) {
        .hero-img {
            animation: heroZoom 20s infinite alternate;
        }
    }
    
    /* Hero Label Animation */
    .hero-line {
        transform: scaleX(0);
        transform-origin: left;
        animation: lineReveal 1s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
    }
    
    @keyframes lineReveal {
        to { transform: scaleX(1); }
    }
    
    .hero-label-text {
        opacity: 0;
        transform: translateX(-10px);
        animation: labelReveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.6s forwards;
    }
    
    @keyframes labelReveal {
        to { 
            opacity: 1;
            transform: translateX(0);
        }
    }
    
    /* Legibility: soft shadows so text holds up over bright image frames */
    .hero-title,
    .hero-word-italic {
        text-shadow: 0 2px 24px rgba(0, 0, 0, 0.55), 0 1px 3px rgba(0, 0, 0, 0.45);
    }

    .hero-label,
    .hero-description p {
        text-shadow: 0 1px 12px rgba(0, 0, 0, 0.6), 0 1px 2px rgba(0, 0, 0, 0.5);
    }

    /* Hero Title Line Animation */
    .hero-word-line {
        display: block;
        opacity: 0;
        transform: translateY(40px);
        animation: wordReveal 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    
    .hero-word-line:nth-child(1) { animation-delay: 0.4s; }
    .hero-word-line:nth-child(2) { animation-delay: 0.55s; }
    
    .hero-word-italic {
        display: inline-block;
        opacity: 0;
        transform: translateY(40px);
        animation: wordReveal 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.8s forwards;
    }
    
    @keyframes wordReveal {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    /* Hero Description Animation */
    .hero-description {
        opacity: 0;
        transform: translateY(30px);
        animation: fadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) 1.2s forwards;
    }
    
    @keyframes fadeUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    /* Hero Right Side Animation */
    .hero-right {
        opacity: 0;
        animation: fadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) 1.4s forwards;
    }
    
    .hero-mobile-cta {
        opacity: 0;
        animation: fadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) 1.3s forwards;
    }
    
    /* Scroll Indicator Animation */
    .scroll-indicator {
        opacity: 0;
        animation: fadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) 2s forwards;
    }
    
    .scroll-line {
        animation: scrollPulse 2s ease-in-out infinite;
    }
    
    @keyframes scrollPulse {
        0%, 100% { 
            opacity: 0.4;
            transform: scaleY(1);
        }
        50% { 
            opacity: 0.8;
            transform: scaleY(1.2);
        }
    }
    
</style>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        function runCarousel(images) {
            if (images.length < 2) return;
            let currentIndex = 0;

            setInterval(() => {
                // Fade out current
                images[currentIndex].classList.remove('opacity-100');
                images[currentIndex].classList.add('opacity-0');

                // Move to next
                currentIndex = (currentIndex + 1) % images.length;

                // Fade in next
                images[currentIndex].classList.remove('opacity-0');
                images[currentIndex].classList.add('opacity-100');
            }, 6000); // Change every 6 seconds
        }

        runCarousel(document.querySelectorAll('.hero-carousel-img'));        // desktop
        runCarousel(document.querySelectorAll('.hero-carousel-img-mobile')); // mobile
    });
</script>
