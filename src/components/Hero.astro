---
// Hero section component
---

<header class="relative h-[100dvh] w-full flex items-center justify-center overflow-hidden">
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
        <!-- Gradient Overlay: Dark bottom -> 50% dark middle -> Light darker top for nav contrast -->
        <div class="absolute inset-0 bg-gradient-to-t from-brand-black via-brand-black/50 to-brand-black/20 z-10"></div>
        <!-- Mobile Hero Image (optimized) -->
        <img 
            src="/images/mobile-hero.avif" 
            class="w-full h-full object-cover md:hidden" 
            alt="Luxury Interior"
        >
        <!-- Desktop Hero Image -->
        <img 
            src="https://images.unsplash.com/photo-1631679706909-1844bbd07221?q=80&w=2600&auto=format&fit=crop" 
            class="w-full h-full object-cover hero-img scale-105 hidden md:block" 
            alt="Luxury Interior"
        >
    </div>

    <div class="relative z-20 w-full max-w-[1400px] px-6 md:px-12 flex flex-col md:flex-row items-start md:items-end justify-between pb-12 md:pb-24 h-full pt-32 md:pt-0">
        <!-- Left Content -->
        <div class="space-y-6 md:space-y-6 max-w-4xl mt-auto md:mt-0">
            <div class="overflow-hidden">
                <p class="hero-label text-xs md:text-xs font-bold tracking-[0.2em] text-gray-300 opacity-80 uppercase mb-4 flex items-center gap-3">
                    <span class="hero-line w-8 md:w-8 h-[1px] bg-gray-300"></span>
                    <span class="hero-label-text">STR Interior Design</span>
                </p>
            </div>
            
            <h1 class="hero-title text-[2.75rem] sm:text-5xl md:text-7xl lg:text-8xl font-serif font-light tracking-tighter leading-[0.95] text-white">
                <span class="hero-word">Your</span> <span class="hero-word">rental,</span> <span class="hero-word">designed</span> <br>
                <span class="text-brand-cream italic font-normal opacity-90 hero-word-italic">to stand out.</span>
            </h1>

            <div class="hero-description max-w-md mt-6 md:mt-8 border-l border-white/20 pl-6">
                <p class="text-base md:text-base text-gray-300 font-light leading-relaxed">
                    We're an interior design studio that turns your short-term rental into a scroll-stopping, five-star guest experience — fully designed, furnished, and photo-ready.
                </p>
                <!-- Solid Button (Current) -->
                <a href="#estimate" class="inline-block mt-8 bg-white text-black px-8 py-3 rounded-full text-xs font-bold uppercase tracking-widest transition-all duration-300 hover:bg-gray-100 shadow-lg">
                    Get Your Estimate
                </a>
                
                <!-- Outline Button (Previous) -->
                <!-- <a href="#estimate" class="inline-block mt-8 border border-white bg-transparent hover:bg-white hover:text-black text-white px-8 py-3 rounded-full text-xs font-bold uppercase tracking-widest transition-all duration-300">
                    Get Your Estimate
                </a> -->
            </div>
            
            <!-- Mobile CTA & Social Proof -->
            <div class="md:hidden flex flex-col items-start gap-6 hero-mobile-cta">
                <a href="#estimate" class="inline-block mt-4 bg-white text-black px-10 py-4 rounded-full shadow-lg">
                    <span class="text-xs font-bold tracking-widest uppercase">Get Your Estimate</span>
                </a>

                <!-- Hidden on mobile to save space -->
                <div class="hidden items-center gap-4">
                    <span class="text-[11px] uppercase tracking-widest text-white/90 font-medium drop-shadow-md">Designed for all major STR platforms</span>
                </div>
            </div>
        </div>

            <!-- Desktop Right Column -->
        <div class="hidden md:flex flex-col items-end gap-4 hero-right">
            <div class="flex items-center gap-6 hero-logos">
                <span class="text-[10px] uppercase tracking-widest text-white/90 font-medium drop-shadow-md">Designed for all major STR platforms</span>
            </div>
            
        </div>
    </div>
    
    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 hidden md:flex flex-col items-center gap-2 scroll-indicator">
        <span class="text-[9px] uppercase tracking-widest text-white/40">Scroll</span>
        <div class="w-[1px] h-12 bg-gradient-to-b from-white/40 to-transparent scroll-line"></div>
    </div>
</header>

<style>
    /* Hero Image Ken Burns Effect - Desktop only for performance */
    @keyframes heroZoom {
        0% { transform: scale(1.05); }
        100% { transform: scale(1.15); }
    }
    
    .hero-img {
        animation: none;
    }
    
    @media (min-width: 768px) {
        .hero-img {
            animation: heroZoom 20s infinite alternate;
        }
    }
    
    /* Hero Label Animation */
    .hero-line {
        transform: scaleX(0);
        transform-origin: left;
        animation: lineReveal 1s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
    }
    
    @keyframes lineReveal {
        to { transform: scaleX(1); }
    }
    
    .hero-label-text {
        opacity: 0;
        transform: translateX(-10px);
        animation: labelReveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.6s forwards;
    }
    
    @keyframes labelReveal {
        to { 
            opacity: 1;
            transform: translateX(0);
        }
    }
    
    /* Hero Title Word Animation */
    .hero-word {
        display: inline-block;
        opacity: 0;
        transform: translateY(40px);
        animation: wordReveal 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    
    .hero-word:nth-child(1) { animation-delay: 0.4s; }
    .hero-word:nth-child(2) { animation-delay: 0.5s; }
    .hero-word:nth-child(3) { animation-delay: 0.6s; }
    
    .hero-word-italic {
        display: inline-block;
        opacity: 0;
        transform: translateY(40px);
        animation: wordReveal 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0.8s forwards;
    }
    
    @keyframes wordReveal {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    /* Hero Description Animation */
    .hero-description {
        opacity: 0;
        transform: translateY(30px);
        animation: fadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) 1.2s forwards;
    }
    
    @keyframes fadeUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    /* Hero Right Side Animation */
    .hero-right {
        opacity: 0;
        animation: fadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) 1.4s forwards;
    }
    
    .hero-mobile-cta {
        opacity: 0;
        animation: fadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) 1.3s forwards;
    }
    
    /* Scroll Indicator Animation */
    .scroll-indicator {
        opacity: 0;
        animation: fadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) 2s forwards;
    }
    
    .scroll-line {
        animation: scrollPulse 2s ease-in-out infinite;
    }
    
    @keyframes scrollPulse {
        0%, 100% { 
            opacity: 0.4;
            transform: scaleY(1);
        }
        50% { 
            opacity: 0.8;
            transform: scaleY(1.2);
        }
    }
    
</style>
