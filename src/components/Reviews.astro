---
// Reviews section component
const reviews = [
    {
        text: "They made designing our short-term rental SO easy. We were set up and booking in no time. Couldn't be happier.",
        name: "Mike & Jenna T.",
        detail: "Scottsdale, AZ",
        headshot: "/images/headshot-mike-jenna-placeholder.jpg"
    },
    {
        text: "As first-time investors, we had no idea where to start. Solstizio walked us through everything and the final result blew us away.",
        name: "Sarah M.",
        detail: "First-Time STR Investor",
        headshot: "/images/headshot-sarah-placeholder.jpg"
    },
    {
        text: "The design, communication, and attention to detail were incredible. Our listing photos turned out amazing and we started getting bookings right away.",
        name: "David R.",
        detail: "Out-of-State Investor",
        headshot: "/images/headshot-david-placeholder.jpg"
    }
];
---

<section id="reviews" class="py-16 md:py-32 px-4 md:px-6 bg-brand-black relative overflow-hidden reviews-section">
    <!-- Decorative abstract shape with pulse -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] md:w-[600px] h-[400px] md:h-[600px] pointer-events-none z-0">
        <div class="reviews-glow w-full h-full bg-brand-gold/5 rounded-full blur-[80px] md:blur-[100px]"></div>
    </div>

    <div class="max-w-5xl mx-auto relative z-10">
        <!-- Section header -->
        <div class="text-center mb-10 md:mb-16">
            <div class="review-icon flex justify-center mb-6 md:mb-8">
                <iconify-icon icon="solar:star-fall-minimalistic-2-linear" class="text-brand-gold" width="28"></iconify-icon>
            </div>

            <!-- Hero quote -->
            <h3 class="review-quote text-2xl sm:text-3xl md:text-5xl font-serif italic text-white leading-tight mb-6 md:mb-8 px-2 max-w-4xl mx-auto">
                <span class="review-word">Solstizio</span> <span class="review-word">completely</span> <span class="review-word">transformed</span> <span class="review-word">our</span> <span class="review-word">rental.</span> <span class="review-word">As</span> <span class="review-word review-highlight">first-time</span> <span class="review-word">investors,</span> <span class="review-word">we</span> <span class="review-word">had</span> <span class="review-word">no</span> <span class="review-word">idea</span> <span class="review-word">where</span> <span class="review-word">to</span> <span class="review-word">start</span> <span class="review-word">—</span> <span class="review-word">they</span> <span class="review-word">made</span> <span class="review-word">the</span> <span class="review-word">whole</span> <span class="review-word">process</span> <span class="review-word review-highlight">effortless.</span>
            </h3>

            <div class="review-attribution flex flex-col items-center gap-1 md:gap-2">
                <span class="text-[10px] md:text-xs font-bold uppercase tracking-widest text-brand-cream">Sarah M.</span>
                <span class="text-[9px] md:text-[10px] uppercase tracking-widest text-brand-muted">First-Time STR Investor — Scottsdale, AZ</span>
            </div>
        </div>

        <!-- Review cards grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6 mt-12 md:mt-16 pt-10 md:pt-12 border-t border-brand-border">
            {reviews.map((review, index) => (
                <div class="review-card group p-5 md:p-6 border border-brand-border bg-brand-panel/50 hover:bg-brand-panel transition-all duration-500 relative" style={`--review-delay: ${index * 0.12}s`}>
                    <div class="flex gap-1 mb-3 md:mb-4">
                        {[...Array(5)].map(() => (
                            <iconify-icon icon="solar:star-bold" class="text-brand-gold" width="14"></iconify-icon>
                        ))}
                    </div>
                    <p class="text-sm text-gray-300 font-light leading-relaxed mb-4 md:mb-5">"{review.text}"</p>
                    <div class="mt-auto flex items-center gap-3">
                        <img src={review.headshot} alt={review.name} class="w-9 h-9 rounded-full object-cover bg-brand-border shrink-0">
                        <div>
                            <span class="text-xs font-bold uppercase tracking-widest text-brand-cream block">{review.name}</span>
                            <span class="text-[9px] uppercase tracking-widest text-brand-muted">{review.detail}</span>
                        </div>
                    </div>
                    <div class="absolute bottom-0 left-0 h-[2px] w-0 bg-brand-gold/30 group-hover:w-full transition-all duration-700"></div>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    /* Glow pulse animation */
    .reviews-glow {
        animation: glowPulse 8s ease-in-out infinite;
        will-change: transform, opacity;
        backface-visibility: hidden;
        transform: translateZ(0);
    }
    
    @keyframes glowPulse {
        0%, 100% { 
            opacity: 0.5;
            transform: scale(1);
        }
        50% { 
            opacity: 0.8;
            transform: scale(1.1);
        }
    }
    
    /* Icon animation */
    .review-icon {
        opacity: 0;
        transform: scale(0) rotate(-180deg);
    }
    
    .reviews-section.in-view .review-icon {
        animation: iconSpin 1s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
    }
    
    @keyframes iconSpin {
        to {
            opacity: 1;
            transform: scale(1) rotate(0deg);
        }
    }
    
    /* Word-by-word reveal */
    .review-word {
        display: inline-block;
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    
    .reviews-section.in-view .review-word {
        opacity: 1;
        transform: translateY(0);
    }
    
    /* Stagger the word animations */
    .reviews-section.in-view .review-word:nth-child(1) { transition-delay: 0.3s; }
    .reviews-section.in-view .review-word:nth-child(2) { transition-delay: 0.35s; }
    .reviews-section.in-view .review-word:nth-child(3) { transition-delay: 0.4s; }
    .reviews-section.in-view .review-word:nth-child(4) { transition-delay: 0.45s; }
    .reviews-section.in-view .review-word:nth-child(5) { transition-delay: 0.5s; }
    .reviews-section.in-view .review-word:nth-child(6) { transition-delay: 0.55s; }
    .reviews-section.in-view .review-word:nth-child(7) { transition-delay: 0.6s; }
    .reviews-section.in-view .review-word:nth-child(8) { transition-delay: 0.65s; }
    .reviews-section.in-view .review-word:nth-child(9) { transition-delay: 0.7s; }
    .reviews-section.in-view .review-word:nth-child(10) { transition-delay: 0.75s; }
    .reviews-section.in-view .review-word:nth-child(11) { transition-delay: 0.8s; }
    .reviews-section.in-view .review-word:nth-child(12) { transition-delay: 0.85s; }
    .reviews-section.in-view .review-word:nth-child(13) { transition-delay: 0.9s; }
    .reviews-section.in-view .review-word:nth-child(14) { transition-delay: 0.95s; }
    .reviews-section.in-view .review-word:nth-child(15) { transition-delay: 1s; }
    .reviews-section.in-view .review-word:nth-child(16) { transition-delay: 1.05s; }
    .reviews-section.in-view .review-word:nth-child(17) { transition-delay: 1.1s; }
    .reviews-section.in-view .review-word:nth-child(18) { transition-delay: 1.15s; }
    .reviews-section.in-view .review-word:nth-child(19) { transition-delay: 1.2s; }
    .reviews-section.in-view .review-word:nth-child(20) { transition-delay: 1.25s; }
    .reviews-section.in-view .review-word:nth-child(21) { transition-delay: 1.3s; }
    .reviews-section.in-view .review-word:nth-child(22) { transition-delay: 1.35s; }
    
    .review-highlight {
        color: #8A9A7B;
    }
    
    /* Attribution animation */
    .review-attribution {
        opacity: 0;
        transform: translateY(15px);
    }
    
    .reviews-section.in-view .review-attribution {
        animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 1.5s forwards;
    }
    
    /* Review cards animation */
    .review-card {
        opacity: 0;
        transform: translateY(25px);
    }

    .reviews-section.in-view .review-card {
        animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        animation-delay: calc(1.6s + var(--review-delay));
    }
    
    @keyframes fadeUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
        const section = document.querySelector('.reviews-section');
        
        if (section) {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('in-view');
                    }
                });
            }, { threshold: 0.15 });
            
            observer.observe(section);
        }
    });
</script>
