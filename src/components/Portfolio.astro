---
// Portfolio section component
const projects = [
    {
        title: "Clayhill",
        location: "Logan, OH",
        type: "Full Design & Install",
        image: "/images/clayhill.avif"
    },
    {
        title: "Leveille Luxury",
        location: "Lawrenceburg, KY",
        type: "Full Design & Install",
        image: "/images/leveille-luxury.avif"
    },
    {
        title: "Pintail",
        location: "Flagstaff, AZ",
        type: "Turnkey Styling",
        image: "/images/pintail-flagstaff.avif"
    },
    {
        title: "Casa Serenity",
        location: "Scottsdale, AZ",
        type: "Interior Design",
        image: "/images/casa-serenity.avif"
    },
    {
        title: "Millards",
        location: "California",
        type: "Full Design & Install",
        image: "/images/Millards Interior 1.jpeg"
    },
    {
        title: "The Balboa",
        location: "Florida",
        type: "Full Design & Install",
        image: "/images/the-balboa.avif"
    }
];
---

<section id="portfolio" class="bg-brand-black py-16 md:pb-32 px-4 md:px-12 portfolio-section">
    <div class="max-w-[1400px] mx-auto">
        <div class="portfolio-header flex items-end justify-between mb-8 md:mb-16 border-b border-brand-border pb-4 md:pb-6 relative">
            <h3 class="text-lg md:text-xl font-serif italic text-white tracking-tight">Selected Works</h3>
            <!-- Animated border -->
            <div class="portfolio-header-line absolute bottom-0 left-0 h-[1px] w-full bg-brand-border"></div>
        </div>

        <!-- Mobile Grid (1 column) -->
        <div class="grid grid-cols-1 gap-6 md:hidden">
            {projects.map((project, index) => (
                <div class="portfolio-card group" style={`--card-delay: ${index * 0.1}s`}>
                    <div class="portfolio-image-container img-zoom-container aspect-video bg-brand-panel relative rounded-sm overflow-hidden">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity z-10 duration-700"></div>
                        <img src={project.image} class="w-full h-full object-cover img-zoom" alt={project.title}>
                    </div>
                    <div class="mt-2">
                        <h4 class="text-sm font-serif text-brand-cream group-hover:text-brand-gold transition-colors duration-300 truncate tracking-tight">{project.title}</h4>
                        <span class="text-[9px] text-brand-muted uppercase tracking-wider">{project.location}</span>
                    </div>
                </div>
            ))}
        </div>

        <!-- Desktop Gallery Grid -->
        <div class="hidden md:grid grid-cols-2 gap-8 lg:gap-10">
            {projects.map((project, index) => (
                <div 
                    class="portfolio-card group"
                    style={`--card-delay: ${index * 0.12}s`}
                >
                    <div class="portfolio-image-container img-zoom-container aspect-[4/3] bg-brand-panel relative">
                        <!-- Overlay gradient -->
                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity z-10 duration-700"></div>
                        
                        <!-- Image -->
                        <img src={project.image} class="w-full h-full object-cover img-zoom" alt={project.title}>
                        
                        <!-- Hover reveal content -->
                        <div class="absolute bottom-0 left-0 right-0 p-8 z-20">
                            <span class="portfolio-tag inline-block text-xs font-bold uppercase tracking-widest bg-white text-black px-4 py-2 translate-y-8 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500 ease-out">
                                {project.location}
                            </span>
                        </div>
                        
                        <!-- Corner accent -->
                        <div class="absolute top-0 right-0 w-16 h-16 overflow-hidden opacity-0 group-hover:opacity-100 transition-opacity duration-700">
                            <div class="absolute top-4 -right-8 w-24 h-[1px] bg-white/30 rotate-45"></div>
                        </div>
                    </div>
                    
                    <!-- Title section -->
                    <div class="flex justify-between items-baseline mt-4">
                        <h4 class="portfolio-title text-2xl md:text-3xl font-serif text-brand-cream transition-colors duration-300 tracking-tight">
                            {project.title}
                        </h4>
                        <span class="text-xs text-brand-muted uppercase tracking-widest group-hover:text-gray-400 transition-colors duration-300">{project.type}</span>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    .portfolio-card {
        opacity: 0;
        transform: translateY(40px);
    }
    
    .portfolio-section.in-view .portfolio-card {
        animation: cardReveal 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        animation-delay: var(--card-delay);
    }
    
    @keyframes cardReveal {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .portfolio-header {
        opacity: 0;
        transform: translateY(20px);
    }
    
    .portfolio-section.in-view .portfolio-header {
        animation: cardReveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    
    /* Image container clip reveal */
    .portfolio-image-container {
        clip-path: inset(0 0 0 0);
    }
    
</style>

<script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
        const section = document.querySelector('.portfolio-section');
        
        if (section) {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('in-view');
                    }
                });
            }, { 
                threshold: 0,
                rootMargin: "0px 0px -15% 0px"
            });
            
            observer.observe(section);
        }
    });
</script>
