---
// Portfolio section component
// Set image2 to a file in /public/images when the second photo is ready.
const projects = [
    {
        title: "Clayhill",
        location: "Logan, OH",
        type: "Full Design & Install",
        image: "/images/clayhill.avif",
        image2: "/images/clayhill-entryway.jpg"
    },
    {
        title: "Leveille Luxury",
        location: "Lawrenceburg, KY",
        type: "Full Design & Install",
        image: "/images/leveille-luxury.avif",
        image2: "/images/leveille-luxury-bedroom.jpg"
    },
    {
        title: "Pintail",
        location: "Flagstaff, AZ",
        type: "Turnkey Styling",
        image: "/images/pintail-flagstaff.avif",
        image2: "/images/pintail-dining.jpg"
    },
    {
        title: "Casa Serenity",
        location: "Scottsdale, AZ",
        type: "Interior Design",
        image: "/images/casa-serenity.avif",
        image2: "/images/casa-serenity-bedroom.jpg"
    },
    {
        title: "Millards",
        location: "California",
        type: "Full Design & Install",
        image: "/images/Millards Interior 1.jpeg",
        image2: "/images/millards-court.jpg"
    },
    {
        title: "Desert Oasis",
        location: "Scottsdale, AZ",
        type: "Full Design & Install",
        image: "/images/desert-oasis-exterior.jpg",
        image2: "/images/desert-oasis-bedroom.jpg"
    }
];
---

<section id="portfolio" class="bg-brand-black py-16 md:pb-32 px-4 md:px-12 portfolio-section">
    <div class="max-w-[1400px] mx-auto">
        <div class="portfolio-header flex items-end justify-between mb-8 md:mb-16 border-b border-brand-border pb-4 md:pb-6 relative">
            <h3 class="text-lg md:text-xl font-serif italic text-white tracking-tight">Selected Works</h3>
            <!-- Animated border -->
            <div class="portfolio-header-line absolute bottom-0 left-0 h-[1px] w-full bg-brand-border"></div>
        </div>

        <!-- Mobile Grid (1 column) -->
        <div class="grid grid-cols-1 gap-10 md:hidden">
            {projects.map((project, index) => (
                <div class="portfolio-card group" style={`--card-delay: ${index * 0.1}s`}>
                    <div class="grid grid-cols-1 gap-1.5">
                        <div class="portfolio-image-container aspect-[4/3] bg-brand-panel relative rounded-sm overflow-hidden">
                            <img src={project.image} class="w-full h-full object-cover portfolio-img" alt={project.title}>
                        </div>
                        <div class="portfolio-image-container aspect-[4/3] bg-brand-panel relative rounded-sm overflow-hidden">
                            {project.image2 ? (
                                <img src={project.image2} class="w-full h-full object-cover portfolio-img" alt={`${project.title}, additional view`}>
                            ) : (
                                <div class="portfolio-placeholder" aria-label={`${project.title} second image placeholder`}>
                                    <span class="portfolio-placeholder-index">02</span>
                                    <span class="portfolio-placeholder-label">{project.title}</span>
                                </div>
                            )}
                        </div>
                    </div>
                    <div class="mt-3 flex items-baseline justify-between gap-3">
                        <div class="min-w-0">
                            <h4 class="text-sm font-serif text-brand-cream group-hover:text-brand-gold transition-colors duration-300 truncate tracking-tight">{project.title}</h4>
                            <span class="text-[9px] text-brand-muted uppercase tracking-wider">{project.location}</span>
                        </div>
                        <span class="text-[9px] text-brand-muted uppercase tracking-wider shrink-0">{project.type}</span>
                    </div>
                </div>
            ))}
        </div>

        <!-- Desktop Gallery Grid -->
        <div class="hidden md:grid grid-cols-2 gap-8 lg:gap-10">
            {projects.map((project, index) => (
                <div 
                    class="portfolio-card group"
                    style={`--card-delay: ${index * 0.12}s`}
                >
                    <div class="grid grid-cols-2 gap-2">
                        <div class="portfolio-image-container aspect-[4/5] bg-brand-panel relative">
                            <img src={project.image} class="w-full h-full object-cover portfolio-img" alt={project.title}>
                        </div>
                        <div class="portfolio-image-container aspect-[4/5] bg-brand-panel relative">
                            {project.image2 ? (
                                <img src={project.image2} class="w-full h-full object-cover portfolio-img" alt={`${project.title}, additional view`}>
                            ) : (
                                <div class="portfolio-placeholder" aria-label={`${project.title} second image placeholder`}>
                                    <span class="portfolio-placeholder-index">02</span>
                                    <span class="portfolio-placeholder-label">{project.title}</span>
                                </div>
                            )}
                        </div>
                    </div>
                    
                    <!-- Title section -->
                    <div class="flex justify-between items-baseline mt-4 gap-4">
                        <div class="min-w-0">
                            <h4 class="portfolio-title text-2xl md:text-3xl font-serif text-brand-cream transition-colors duration-300 tracking-tight">
                                {project.title}
                            </h4>
                            <span class="text-[10px] text-brand-muted uppercase tracking-widest">{project.location}</span>
                        </div>
                        <span class="text-xs text-brand-muted uppercase tracking-widest group-hover:text-gray-400 transition-colors duration-300 shrink-0">{project.type}</span>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    .portfolio-card {
        opacity: 0;
        transform: translateY(40px);
    }
    
    .portfolio-section.in-view .portfolio-card {
        animation: cardReveal 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        animation-delay: var(--card-delay);
    }
    
    @keyframes cardReveal {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .portfolio-header {
        opacity: 0;
        transform: translateY(20px);
    }
    
    .portfolio-section.in-view .portfolio-header {
        animation: cardReveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    
    /* Per-image hover zoom (each image reacts individually, not as a group) */
    .portfolio-image-container {
        clip-path: inset(0 0 0 0);
        overflow: hidden;
        position: relative;
    }

    .portfolio-image-container::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.4) 0%, transparent 50%);
        z-index: 1;
        opacity: 0;
        transition: opacity 0.6s var(--ease-out-expo);
        pointer-events: none;
    }

    .portfolio-image-container:hover::before {
        opacity: 1;
    }

    .portfolio-img {
        transition: transform 1.8s var(--ease-out-expo), filter 1s var(--ease-out-expo);
        transform: translateZ(0);
        will-change: transform;
        backface-visibility: hidden;
    }

    .portfolio-image-container:hover .portfolio-img {
        transform: scale(1.08);
    }

    .portfolio-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        background: #111111;
        border: 1px solid rgba(255, 255, 255, 0.06);
    }

    .portfolio-placeholder-index {
        font-family: inherit;
        font-style: italic;
        font-size: 1.25rem;
        letter-spacing: 0.08em;
        color: rgba(245, 240, 232, 0.28);
    }

    .portfolio-placeholder-label {
        font-size: 9px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.22);
    }
</style>

<script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
        const section = document.querySelector('.portfolio-section');
        
        if (section) {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('in-view');
                    }
                });
            }, { 
                threshold: 0,
                rootMargin: "0px 0px -15% 0px"
            });
            
            observer.observe(section);
        }
    });
</script>
